{
  "manifest_version": 3,
  "name": "Web Time Tracker for Art",
  "version": "1.0",
  "description": "Sledzi czas spedzony na domenach do wykorzystania w sztuce generatywnej.",
  "permissions": [
    "tabs",
    "storage",
    "downloads"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "time-tracker-art@example.com"
    }
  }
}